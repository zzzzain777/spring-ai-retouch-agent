# 复制本文件为同目录下的 application-local.yml，再填入真实密钥。
# application-local.yml 已被 .gitignore 忽略，不会提交到公开仓库。
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml

spring:
  # 数据库：不写这一段就连本机 docker compose 里的 PostgreSQL（7311）。
  # 改用阿里云 RDS PostgreSQL 时取消注释并填写（步骤见 server/README.md）：
  # datasource:
  #   url: jdbc:postgresql://在这里填RDS外网地址:5432/retouch?sslmode=prefer
  #   username: 在这里填RDS账号
  #   password: 在这里填该账号的密码

  # Redis：不写就连 docker compose 里的 7312。用本机自己装的 Redis（默认 6379）时取消注释：
  # data:
  #   redis:
  #     url: redis://127.0.0.1:6379/0

  ai:
    openai:
      # 方式一：DeepSeek（默认）
      api-key: 在这里填 DeepSeek 的 key
      base-url: https://api.deepseek.com
      chat:
        model: deepseek-chat

      # 方式二：阿里云百炼 DashScope 的 OpenAI 兼容模式（通义千问）。用这个时把上面三项换成：
      # api-key: 在这里填 DashScope 的 key
      # base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
      # chat:
      #   model: qwen-plus

retouch:
  image:
    dashscope:
      # 图像模型用 DashScope；暂时不用图像功能可以留空
      api-key:
